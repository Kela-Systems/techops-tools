# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# Environment files
.env
.env.local
.env.*.local

# Bench-central: a local dev database (production lives in /var/lib/bench-central)
bench-central/*.db
bench-central/*.db-wal
bench-central/*.db-shm

# Real device/config files — commit only the *.example.* variants
hub-admin/device_config.json
hub-admin/device_config.*.json
hub-admin/hub-admin.yaml

# Exported site profiles (may contain device IPs/creds) — commit only *.example.*
*.profile.json
!*.profile.example.json

# Generated outputs from the raster scripts
deployments_scripts/tiff_output/
site_outputs/
mosaic_temp.vrt
*.gpkg-journal

# Exported DB extracts
map_features_*.csv

# Large binary geo data — keep in S3 / external storage, not git
*.gpkg
*.tif
*.tiff

# OTD500 tool — real secrets/config + firmware images
bench/otd-config-ui/config/site.config.json
bench/otd-config-ui/firmware/

# RUTM08 tool — real secrets/config + firmware images
bench/rutm-config-ui/config/rutm.config.json
bench/rutm-config-ui/firmware/

# Magos radar tool — real secrets/config. This rule was MISSING while every
# other bench tool had one, so the operator-editable config itself was
# committed in ba0cea4 (2026-08-10). Nothing secret leaked: the committed
# values are the documented factory defaults (admin/password). But the file
# is edited per station, so the next operator to set a real password would
# have committed it. Commit only the *.example.json variant.
bench/magos-config-ui/config/magos.config.json
bench/magos-config-ui/firmware/

# TSW202 tool — real secrets/config + firmware images
bench/tsw-config-ui/config/tsw.config.json
bench/tsw-config-ui/firmware/

# PLANET IGS-4215 PoE switch tool — real config + firmware images.
# The .bix is ~7 MB and is what a switch below the SSH-fix floor needs.
bench/planet-config-ui/config/planet.config.json
bench/planet-config-ui/firmware/

# Raythink camera tool — real config (copy from the example).
# The config/profiles/ exports ship committed, because they are needed at
# runtime. That is only safe for a SANITIZED export: a raw one from the newer
# (REST) cameras carries the station password in plaintext under OnvifUser, and
# both generations carry the reference camera's own address. Run any new export
# through `raythink_configure.py --sanitize-profile` before committing it —
# see "Config profiles" in bench/raythink-config-ui/README.md.
bench/raythink-config-ui/config/raythink.config.json
# Firmware images, as for the other three tools: far too large for git (the
# newer cameras' image is a ~58 MB zip) and vendor-supplied rather than ours.
bench/raythink-config-ui/firmware/

# The address mode each tool is set to (TEC-848) — station state an operator
# flips during a shift, not checked-in intent. `ip_state.json` is the older
# name the camera tool used before the modes were shared.
bench/*/ip-state.json
bench/raythink-config-ui/ip_state.json

# Provision-ISR speaker tool — real config (copy from the example) + the media
# file dropped into config/media/ (site-specific audio; keep out of git)
bench/speaker-config-ui/config/speaker.config.json
bench/speaker-config-ui/config/media/*
!bench/speaker-config-ui/config/media/.gitkeep

# Bench station state — the operator name entered at day start (TEC-345)
bench/.bench-operator.json
bench/.bench-operator.tmp

# Bench station identity + bundle stamp (written by setup-station.* and the
# bench-central bundle build; per-station, must never reach a bundle)
bench/.bench-station.json
bench/.bench-build.json
bench/*.bundle.zip

# Logs
*.log
bench/magos-config-ui/logs/
bench/otd-config-ui/logs/
bench/rutm-config-ui/logs/
bench/tsw-config-ui/logs/
bench/planet-config-ui/logs/
bench/raythink-config-ui/logs/
bench/speaker-config-ui/logs/

# Rugged operator USB builder — real secrets (live Tailscale auth key; commit
# only secrets.env.example), ISOs (multi-GB, and the built ISO embeds the auth
# key), and the offline package pool (~8 GB, regenerable)
rugged_operator/usb-builder/secrets*.env
*.iso
rugged_operator/usb-builder/offline-pool/

# Cluster auth helpers
kubeconfig

# Service account for Google Sheets API
deploy-tracker/service_account.json
