# ============================================================================
#  secrets.env — baked into the operator install USB at build time.
#  Copy this file to `secrets.env` next to build-iso.sh and fill it in.
#
#  WARNING: the resulting ISO contains TS_AUTHKEY in /operator/secrets.env and
#  in /etc/kela/operator-secrets.env on the installed system. Treat the ISO
#  itself as a secret. operator-setup.sh consumes the key and the first-boot
#  runner shreds the file from disk on success.
# ============================================================================

# Tailscale auth key — generate a REUSABLE, EPHEMERAL=false, PRE-APPROVED,
# TAGGED key from https://login.tailscale.com/admin/settings/keys
# The auth key MUST be authorized to apply the tags listed in TS_TAGS.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Expiry date of TS_AUTHKEY (shown in the Tailscale admin UI when you create
# the key; max 90 days). build-iso.sh refuses to build with an expired key
# and warns when <14 days remain — a stick built from a stale key installs
# fine and then fails `tailscale up` in the field.
TS_KEY_EXPIRY=YYYY-MM-DD

# ACL tags applied at `tailscale up --advertise-tags`. Comma-separated.
# `tag:` prefix is added automatically if you forget it, so either form
# works:  "operator,fob-12"  or  "tag:operator,tag:fob-12"
TS_TAGS=tag:operator

# Optional: override the cert-fetch host.
# By default the cert is pulled from the site server on the LAN
# (192.168.88.10:443, a.k.a. kela.local) — see CERT_FETCH_HOST in setup.sh.
# Override only if the server is reachable under a different host/port.
# CERT_FETCH_HOST=192.168.88.10
# CERT_FETCH_PORT=443

# Optional: inventory check-in. If set, setup.sh POSTs /etc/kela/build-info
# (site, hostname, Tailscale IP, AnyDesk ID, versions) to this URL after a
# successful build. Best-effort — failure is a warning, not fatal.
# KELA_CHECKIN_URL=https://kela.local/api/station-checkin
