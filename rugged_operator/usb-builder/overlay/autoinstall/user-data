#cloud-config
# Subiquity autoinstall for the Kela operator rugged.
# Generated by build-iso.sh — DO NOT EDIT THE BAKED COPY ON THE ISO.
#
# Reference: https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html
autoinstall:
  version: 1

  # Don't try to fetch a newer installer over the internet during boot.
  refresh-installer:
    update: no

  # Accept the EULA + skip every interactive screen.
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Primary user — matches what setup.sh expects (KELA_USER=kela).
  # Hostname is a placeholder; first-boot runs setup.sh which rewrites it
  # to "<site>-operator" after the operator types the site name.
  identity:
    hostname: kela-operator
    realname: Kela
    username: kela
    password: "__KELA_PASSWORD_HASH__"

  # OpenSSH for jumphost access (setup.sh + UFW lock egress down later).
  ssh:
    install-server: true
    allow-pw: true

  # Wipe + install on the first detected disk, no LUKS by default.
  # If a site requires full-disk encryption, set storage.layout.password
  # at build time (or swap to a custom layout).
  storage:
    layout:
      name: direct

  # DHCP on whatever ethernet appears. WiFi is left optional — the
  # operator can configure SSIDs after first boot via GNOME if needed.
  network:
    version: 2
    ethernets:
      ether-any:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
        optional: true

  # No install-time update fetch — the base system comes from the ISO pool;
  # patch centrally over Tailscale later. fallback keeps the BASE install
  # resilient to a flaky mirror (the desktop step in late-commands still
  # requires the network and fails loudly without it).
  apt:
    geoip: false
    fallback: offline-install

  # openssh-server comes from the Server ISO pool via the ssh: section above.
  # The desktop environment (ubuntu-desktop-minimal + gdm3) is NOT on the
  # Server ISO, so it's installed from the archive in late-commands — the
  # install therefore REQUIRES a network (plug ethernet before booting the
  # stick). For parallel bench imaging, set APT_PROXY in secrets.env to an
  # apt-cacher-ng on the bench: the desktop downloads once at LAN speed.

  # Nothing during the install should contact the snap store: Subiquity polls
  # it (a bounded ~20-min retry loop that looks like a hang at the bench),
  # and snap-transitional debs phone it from maintainer scripts (the firefox
  # deb's postinst runs `snap install firefox` — it once wedged an install at
  # "status half-installed firefox"). Fail FAST: point the store at localhost
  # in the live environment so any store contact dies in seconds with a
  # visible error instead of a silent retry loop. (The target chroot gets the
  # same guard around the desktop install below; firefox itself is pinned out.)
  early-commands:
    - echo '127.0.0.1 api.snapcraft.io' >> /etc/hosts

  # All file installs happen here. /target is the new root; /cdrom is the
  # mounted ISO. Files under /cdrom/operator/ came from usb-builder/overlay/.
  late-commands:
    # ---- install the desktop environment (GNOME + gdm3) ------------------
    # From the archive (network required), optionally via a bench apt cache.
    - |
      # set -e is load-bearing: curtin runs this block via `sh -c` WITHOUT -e,
      # so a failed apt would otherwise fall through to the cleanup lines, the
      # block would exit 0, and curtin would declare the install successful —
      # shipping a desktop-less unit that boots to a text console. With -e a
      # failure aborts the autoinstall visibly at the bench.
      set -e
      # Target-side snap-store guard for the duration of the desktop install
      # (removed after): any maintainer script that reaches for the store
      # fails instantly instead of hanging dpkg. firefox is kept out via the
      # pin (-1 = never a candidate, so its Recommends is skipped silently) —
      # a kiosk that ships Chrome has no use for a snap-transitional firefox.
      printf '127.0.0.1 api.snapcraft.io\n' >> /target/etc/hosts
      mkdir -p /target/etc/apt/preferences.d
      printf 'Package: firefox\nPin: release *\nPin-Priority: -1\n' \
        > /target/etc/apt/preferences.d/kela-no-firefox
      # Optional bench apt cache: APT_PROXY in secrets.env (baked on the ISO)
      # points apt at e.g. apt-cacher-ng on the imaging bench, so N parallel
      # installs download the ~2 GB desktop once at LAN speed. Deliberately
      # non-persistent — the options exist only on these commands, so a unit
      # imaged at the bench never carries a dead proxy to the field.
      APT_PROXY="$(. /cdrom/operator/secrets.env 2>/dev/null; echo "${APT_PROXY:-}")"
      PROXY_OPTS=""
      if [ -n "$APT_PROXY" ]; then
        PROXY_OPTS="-o Acquire::http::Proxy=$APT_PROXY -o Acquire::https::Proxy=$APT_PROXY"
        echo "kela: using apt proxy $APT_PROXY"
      fi
      echo "kela: desktop install from archive"
      curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get $PROXY_OPTS update
      echo "kela: desktop install starting (download+unpack+configure, ~15-25 min; disk can go quiet during configure — progress: tail -f /target/var/log/dpkg.log, and Ctrl-C it before the install ends)"
      curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get $PROXY_OPTS -o Dpkg::Use-Pty=0 install -y ubuntu-desktop-minimal gdm3 gnome-terminal
      sed -i '/api\.snapcraft\.io/d' /target/etc/hosts
      echo "kela: desktop install DONE"

    # ---- disarm the apt-daily timers before first boot ------------------
    # apt-daily.timer is Persistent=true, so it can fire seconds into first
    # boot — minutes before the operator answers the site prompt and setup.sh
    # §2 disables it — and hold the dpkg lock. setup.sh's 600s lock-wait
    # absorbs it, but at parallel-imaging scale that's wasted idle minutes per
    # station. Disabling here (idempotent) means the racers never arm at all.
    - curtin in-target --target=/target -- systemctl disable apt-daily.timer apt-daily-upgrade.timer || true

    # ---- auto-login so the first-boot prompt can run in a GUI session
    - mkdir -p /target/etc/gdm3
    - |
      cat > /target/etc/gdm3/custom.conf <<EOF
      [daemon]
      AutomaticLoginEnable=true
      AutomaticLogin=kela
      EOF

    # ---- record the site name typed at the GRUB menu (if any) -------------
    # The patched grub.cfg appends kela.site=<name> to the kernel cmdline.
    # If present, first boot is fully hands-off (the UI skips its prompt).
    - |
      site="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^kela\.site=//p' | head -n1)"
      if [ -n "$site" ]; then
        mkdir -p /target/etc/kela
        printf '%s\n' "$site" > /target/etc/kela/site
        chmod 644 /target/etc/kela/site
        echo "kela: site name from GRUB cmdline: $site"
      else
        echo "kela: no site name on cmdline — first boot will prompt"
      fi

    # ---- drop the operator-setup script (idempotent + re-runnable)
    - install -D -m 0755 /cdrom/operator/operator-setup.sh /target/usr/local/sbin/operator-setup.sh

    # ---- bake the secrets (TS_AUTHKEY, TS_TAGS, …) into the new system
    # Dir is 0755 (the kela user must read /etc/kela/site from the first-boot
    # UI); the secrets file itself stays 0600 root-only.
    - install -d -m 0755 /target/etc/kela
    - install -m 0600 /cdrom/operator/secrets.env /target/etc/kela/operator-secrets.env

    # ---- first-boot prompt + root runner
    - install -D -m 0755 /cdrom/operator/kela-first-boot-ui.sh  /target/usr/local/bin/kela-first-boot-ui
    - install -D -m 0755 /cdrom/operator/kela-first-boot-run.sh /target/usr/local/sbin/kela-first-boot-run

    # ---- one-shot NOPASSWD sudoers drop-in for the runner (self-removed after success)
    - install -D -m 0440 /cdrom/operator/kela-first-boot.sudoers /target/etc/sudoers.d/kela-first-boot
    - curtin in-target --target=/target -- visudo -cf /etc/sudoers.d/kela-first-boot

    # ---- GNOME autostart entry → launches the prompt at first graphical login
    - install -d -m 0755 /target/home/kela/.config/autostart
    - install -m 0644 /cdrom/operator/kela-first-boot.desktop /target/home/kela/.config/autostart/kela-first-boot.desktop

    # ---- suppress the GNOME "Welcome to Ubuntu" wizard — it would pop over
    #      (or steal focus from) the first-boot site-name prompt
    - sh -c 'echo yes > /target/home/kela/.config/gnome-initial-setup-done'

    - curtin in-target --target=/target -- chown -R kela:kela /home/kela/.config

  shutdown: reboot
