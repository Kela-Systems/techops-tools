#cloud-config
# Subiquity autoinstall for the Kela operator rugged.
# Generated by build-iso.sh — DO NOT EDIT THE BAKED COPY ON THE ISO.
#
# Reference: https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html
autoinstall:
  version: 1

  # Don't try to fetch a newer installer over the internet during boot.
  refresh-installer:
    update: no

  # Accept the EULA + skip every interactive screen.
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Primary user — matches what setup.sh expects (KELA_USER=kela).
  # Hostname is a placeholder; first-boot runs setup.sh which rewrites it
  # to "<site>-operator" after the operator types the site name.
  identity:
    hostname: kela-operator
    realname: Kela
    username: kela
    password: "__KELA_PASSWORD_HASH__"

  # OpenSSH for jumphost access (setup.sh + UFW lock egress down later).
  ssh:
    install-server: true
    allow-pw: true

  # Wipe + install on the first detected disk, no LUKS by default.
  # If a site requires full-disk encryption, set storage.layout.password
  # at build time (or swap to a custom layout).
  storage:
    layout:
      name: direct

  # DHCP on whatever ethernet appears. WiFi is left optional — the
  # operator can configure SSIDs after first boot via GNOME if needed.
  network:
    version: 2
    ethernets:
      ether-any:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
        optional: true

  # No install-time update fetch — keeps the base install network-independent
  # (offline-pool builds need this). Patch centrally over Tailscale later.

  # Don't make the base install hard-depend on a reachable archive mirror.
  # When the offline pool is embedded (/cdrom/extras), the desktop installs
  # from it in late-commands and no network is touched at all.
  apt:
    geoip: false
    fallback: offline-install

  # openssh-server comes from the Server ISO pool (offline-safe) via the ssh:
  # section above. The desktop environment (ubuntu-desktop-minimal + gdm3) is
  # NOT on the Server ISO, so it's installed in late-commands — from the local
  # offline pool if present, otherwise from the network.

  # All file installs happen here. /target is the new root; /cdrom is the
  # mounted ISO. Files under /cdrom/operator/ came from usb-builder/overlay/.
  late-commands:
    # ---- install the desktop environment (GNOME + gdm3) ------------------
    # Offline if the pool is embedded (/cdrom/extras), else from the network.
    # The pool is copied to /target/opt/kela-pool and LEFT there so first-boot
    # (operator-setup.sh) can install Tailscale/AnyDesk/Chrome offline too;
    # kela-first-boot-run removes it once setup succeeds.
    - |
      if [ -f /cdrom/extras/Packages ]; then
        echo "kela: OFFLINE desktop install from /cdrom/extras"
        cp -a /cdrom/extras /target/opt/kela-pool
        printf 'deb [trusted=yes] file:/opt/kela-pool ./\n' > /target/etc/apt/kela-offline.list
        curtin in-target --target=/target -- apt-get -o Dir::Etc::SourceList=/etc/apt/kela-offline.list -o Dir::Etc::SourceParts=/dev/null update
        curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get -o Dir::Etc::SourceList=/etc/apt/kela-offline.list -o Dir::Etc::SourceParts=/dev/null install -y ubuntu-desktop-minimal gdm3 gnome-terminal
        rm -f /target/etc/apt/kela-offline.list
      else
        echo "kela: ONLINE desktop install from archive"
        curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get update
        curtin in-target --target=/target -- env DEBIAN_FRONTEND=noninteractive apt-get install -y ubuntu-desktop-minimal gdm3 gnome-terminal
      fi

    # ---- disarm the apt-daily timers before first boot ------------------
    # apt-daily.timer is Persistent=true, so it can fire seconds into first
    # boot — minutes before the operator answers the site prompt and setup.sh
    # §2 disables it — and hold the dpkg lock. setup.sh's 600s lock-wait
    # absorbs it, but at parallel-imaging scale that's wasted idle minutes per
    # station. Disabling here (idempotent) means the racers never arm at all.
    - curtin in-target --target=/target -- systemctl disable apt-daily.timer apt-daily-upgrade.timer || true

    # ---- auto-login so the first-boot prompt can run in a GUI session
    - mkdir -p /target/etc/gdm3
    - |
      cat > /target/etc/gdm3/custom.conf <<EOF
      [daemon]
      AutomaticLoginEnable=true
      AutomaticLogin=kela
      EOF

    # ---- record the site name typed at the GRUB menu (if any) -------------
    # The patched grub.cfg appends kela.site=<name> to the kernel cmdline.
    # If present, first boot is fully hands-off (the UI skips its prompt).
    - |
      site="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^kela\.site=//p' | head -n1)"
      if [ -n "$site" ]; then
        mkdir -p /target/etc/kela
        printf '%s\n' "$site" > /target/etc/kela/site
        chmod 644 /target/etc/kela/site
        echo "kela: site name from GRUB cmdline: $site"
      else
        echo "kela: no site name on cmdline — first boot will prompt"
      fi

    # ---- drop the operator-setup script (idempotent + re-runnable)
    - install -D -m 0755 /cdrom/operator/operator-setup.sh /target/usr/local/sbin/operator-setup.sh

    # ---- bake the secrets (TS_AUTHKEY, TS_TAGS, …) into the new system
    # Dir is 0755 (the kela user must read /etc/kela/site from the first-boot
    # UI); the secrets file itself stays 0600 root-only.
    - install -d -m 0755 /target/etc/kela
    - install -m 0600 /cdrom/operator/secrets.env /target/etc/kela/operator-secrets.env

    # ---- first-boot prompt + root runner
    - install -D -m 0755 /cdrom/operator/kela-first-boot-ui.sh  /target/usr/local/bin/kela-first-boot-ui
    - install -D -m 0755 /cdrom/operator/kela-first-boot-run.sh /target/usr/local/sbin/kela-first-boot-run

    # ---- one-shot NOPASSWD sudoers drop-in for the runner (self-removed after success)
    - install -D -m 0440 /cdrom/operator/kela-first-boot.sudoers /target/etc/sudoers.d/kela-first-boot
    - curtin in-target --target=/target -- visudo -cf /etc/sudoers.d/kela-first-boot

    # ---- GNOME autostart entry → launches the prompt at first graphical login
    - install -d -m 0755 /target/home/kela/.config/autostart
    - install -m 0644 /cdrom/operator/kela-first-boot.desktop /target/home/kela/.config/autostart/kela-first-boot.desktop

    # ---- suppress the GNOME "Welcome to Ubuntu" wizard — it would pop over
    #      (or steal focus from) the first-boot site-name prompt
    - sh -c 'echo yes > /target/home/kela/.config/gnome-initial-setup-done'

    - curtin in-target --target=/target -- chown -R kela:kela /home/kela/.config

  shutdown: reboot
