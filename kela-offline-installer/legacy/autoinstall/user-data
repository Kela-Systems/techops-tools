#cloud-config
# Kela FOB drive — Ubuntu Server 24.04 autoinstall seed (fully unattended).
# WARNING: wipes the smallest eligible disk in the machine without asking.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  source:
    id: ubuntu-server
    search_drivers: false
  # Offline box: don't wait for network
  network:
    version: 2
    ethernets:
      alleth:
        match:
          name: "en*"
        dhcp4: true
        optional: true
  # No updates/snaps possible offline
  updates: security
  refresh-installer:
    update: no
  storage:
    layout:
      name: direct
      match:
        size: smallest
  identity:
    hostname: kela-fob
    username: kela
    # password: kela  — CHANGE THIS before building production drives
    password: "$6$Ovc4PDuUv7OQDwBv$JUN9rYxo.KqFbqD5pCtSk4wlX4inRgopLc/8mCGGRqaqa51hKdgXqBjcWavJBl2cjLYgXyWSvnZNbT/EZmz4L1"
  ssh:
    install-server: true
    allow-pw: true
  shutdown: reboot
  # Cloud-config applied to the INSTALLED system on its first boot:
  user-data:
    write_files:
      - path: /usr/local/sbin/kela-firstboot-activate.sh
        permissions: "0755"
        content: |
          #!/bin/bash
          # First boot: mount the FOB drive's data partition and run Kela activation.
          set -euo pipefail
          exec > >(tee -a /var/log/kela-firstboot.log) 2>&1
          echo "=== kela first-boot activation: $(date -u) ==="
          MNT=/mnt/kela-drive
          mkdir -p "$MNT"
          for i in $(seq 1 30); do
            DEV=$(blkid -L FOBDATA || true)
            [ -n "${DEV:-}" ] && break
            sleep 2
          done
          if [ -z "${DEV:-}" ]; then
            echo "FOBDATA partition not found — is the drive still plugged in?"
            echo "Plug it in and run: sudo /usr/local/sbin/kela-firstboot-activate.sh"
            exit 1
          fi
          mount -o rw "$DEV" "$MNT"
          cd "$MNT/02-kela"
          sh ./activate.sh
          echo "=== activation complete: $(date -u) ==="
          sync
          umount "$MNT" || true
          systemctl disable kela-firstboot-activate.service || true
      - path: /etc/systemd/system/kela-firstboot-activate.service
        permissions: "0644"
        content: |
          [Unit]
          Description=Kela offline bundle first-boot activation
          After=multi-user.target
          ConditionPathExists=!/var/lib/kela/offline

          [Service]
          Type=oneshot
          ExecStart=/usr/local/sbin/kela-firstboot-activate.sh
          RemainAfterExit=yes

          [Install]
          WantedBy=multi-user.target
    runcmd:
      - systemctl daemon-reload
      - systemctl enable --now kela-firstboot-activate.service
