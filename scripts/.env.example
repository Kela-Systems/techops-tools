# RMS (Teltonika Remote Management System)
# Get your token from https://rms.teltonika-networks.com → API → Personal access tokens
RMS_API_TOKEN=

# Droam (SIM/eSIM management platform)
DROAM_URL=https://platform.droam.com
DROAM_USERNAME=
DROAM_PASSWORD=

# SSH into Teltonika devices (sim_audit.py --no-ssh to disable)
# Used to read UCI config for standby/inactive SIM slots RMS doesn't report.
SSH_USER=root
SSH_PASS=

# PagerDuty (session timeout management — pd_session_timeouts.py)
# Needs a REST API key from an admin/account owner:
# PagerDuty web app → Integrations → API Access Keys → Create New API Key
PAGERDUTY_API_TOKEN=
