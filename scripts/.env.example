# RMS (Teltonika Remote Management System)
# Get your token from https://rms.teltonika-networks.com → API → Personal access tokens
RMS_API_TOKEN=

# Droam (SIM/eSIM management platform)
DROAM_URL=https://platform.droam.com
DROAM_USERNAME=
DROAM_PASSWORD=

# SSH enrichment (optional) — used by --ssh flag to read all SIM slot ICCIDs from devices
# Credentials are the same across all OTD500 units.
# SSH_USER defaults to "root" if not set.
SSH_USER=root
SSH_PASS=
